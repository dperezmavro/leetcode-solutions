# Enable Bzlmod (required for MODULE.bazel-based dependency management).
common --enable_bzlmod

# Ensure build actions use a hermetic PATH so results are reproducible
# across machines regardless of local tool installations.
build --incompatible_strict_action_env

# Print test failure output inline rather than only storing it in the log file.
# Without this, a failing test just prints a path and you have to cat the file.
test --test_output=errors

# Silence the "test size too big" warnings — LeetCode tests finish in <1s,
# so the timeout bucket warnings are noise. Increase per-target only when needed.
test --test_verbose_timeout_warnings=false

# Rust clippy lint pass — run: bazel build --config=clippy //...
# The aspect attaches to every rust_* target; the clippy_checks output group
# makes the build fail when clippy reports findings. -Dwarnings promotes all
# clippy warnings to errors. clippy.toml supplies repo-wide lint thresholds.
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=clippy_checks
build:clippy --@rules_rust//:clippy_flags=-Dwarnings
build:clippy --@rules_rust//:clippy.toml=//:clippy.toml

# Advisory (non-fatal) strict lint pass — run: bazel build --config=clippy-strict //...
# Surfaces clippy::pedantic and clippy::nursery findings as WARNINGS. No
# -Dwarnings here, so it never fails the build; it is informational feedback on
# top of the enforced config:clippy gate. clippy_flags is a non-repeatable
# string_list, so multiple flags are comma-separated (a second assignment would
# replace, not append).
build:clippy-strict --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy-strict --output_groups=clippy_checks
build:clippy-strict --@rules_rust//:clippy_flags=-Wclippy::pedantic,-Wclippy::nursery
build:clippy-strict --@rules_rust//:clippy.toml=//:clippy.toml

# rustfmt config is global (NOT under config:rustfmt) so the format CHECK
# (bazel build --config=rustfmt) and the in-place FORMATTER
# (bazel run @rules_rust//:rustfmt) bake the SAME rustfmt.toml. Scoped to
# config:rustfmt, the runner never sees the flag and silently falls back to
# rustfmt defaults (max_width=100), disagreeing with the check (max_width=80).
# rustfmt.toml only affects rustfmt actions, so applying it globally is inert
# for normal build/test.
build --@rules_rust//:rustfmt.toml=//:rustfmt.toml

# Rust format check — run: bazel build --config=rustfmt //...
# Fails when any source is not rustfmt-clean. To fix in place, run:
# bazel run @rules_rust//:rustfmt
build:rustfmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=rustfmt_checks


# Emit git metadata (REPO_URL, COMMIT_SHA, GIT_BRANCH, ...) into the workspace
# status so BuildBuddy populates commit/branch/repo on each invocation.
build --workspace_status_command=scripts/workspace_status.sh

# BuildBuddy Remote Execution (RE) + Remote Cache (CAS).
#
# OPT-IN: enabled only with --config=remote. A bare `bazel build`/`bazel test`
# (no config) runs fully local on the host toolchain and needs no network.
# Rationale for opt-in rather than opt-out: --extra_execution_platforms and
# --extra_toolchains accumulate and cannot be cleanly unset by a later config,
# so making remote the unconditional default and trying to disable it per-invocation
# is fragile. Gate the whole thing behind one config instead.
common:remote --bes_results_url=https://app.buildbuddy.io/invocation/
common:remote --bes_backend=grpcs://remote.buildbuddy.io
common:remote --remote_cache=grpcs://remote.buildbuddy.io
common:remote --noremote_upload_local_results # Uploads logs & artifacts without writing to cache
common:remote --remote_timeout=10m
common:remote --remote_executor=grpcs://remote.buildbuddy.io

# RE runs on Linux/amd64 workers, so pin exec/host/target platforms to the
# BuildBuddy linux_x86_64 platform. This makes toolchains (Go SDK + C++) resolve
# for Linux instead of the darwin host — otherwise the darwin `go` binary is
# shipped to a Linux worker and fails "Exec format error". Use the module-aliased
# label (NOT @buildbuddy_toolchain//:platform, whose alias resolves to the
# host-compatible = darwin platform on this Mac, routing actions to non-existent
# darwin RE workers).
common:remote --extra_execution_platforms=@toolchains_buildbuddy//platforms:linux_x86_64
common:remote --host_platform=@toolchains_buildbuddy//platforms:linux_x86_64
common:remote --platforms=@toolchains_buildbuddy//platforms:linux_x86_64

# Register the matching linux C++ toolchain so cc actions (e.g. building
# @bazel_tools ijar/zipper) resolve on the linux exec platform.
common:remote --extra_toolchains=@toolchains_buildbuddy//toolchains/cc:ubuntu_gcc_x86_64

# The BuildBuddy linux CC toolchain hardcodes `-fuse-ld=gold` in its link_flags,
# so rules_rust links via GNU gold and rustc (>=1.79) warns that gold is
# deprecated. Append `-fuse-ld=bfd` as the last linker arg (last -fuse-ld wins in
# gcc) to link with GNU ld instead. Remote-only, so local darwin (Apple ld) is
# untouched. lld is NOT in the default RE image, so bfd is the safe choice.
common:remote --@rules_rust//:extra_rustc_flag=-Clink-arg=-fuse-ld=bfd
common:remote --@rules_rust//:extra_exec_rustc_flag=-Clink-arg=-fuse-ld=bfd

# Remote cache only (CAS) WITHOUT remote execution: actions run locally but read/
# write the shared cache. Useful offline-tolerant speedup. Enable with
# --config=remote-cache.
common:remote-cache --bes_results_url=https://app.buildbuddy.io/invocation/
common:remote-cache --bes_backend=grpcs://remote.buildbuddy.io
common:remote-cache --remote_cache=grpcs://remote.buildbuddy.io
common:remote-cache --remote_timeout=10m
